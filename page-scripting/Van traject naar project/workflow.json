{
  "$schema": "./workflow.schema.json",
  "name": "Van traject naar project",
  "description": "Volledig traject: aanmaken traject, overdracht, projectkaart inrichten.",
  "bc_url": "https://4psconstruct.bc.dynamics.com/9a3ecacb-258f-4487-9e56-20acb3a16014/Test?company=TestAT",
  "steps": [
    {
      "id": "step-1",
      "name": "Step 1",
      "user": "Acquisiteur",
      "script": "./scripts/Test Recording traject.yml",
      "capture": {
        "try_out_successor_project_no": "Try-out Successor - Project No."
      }
    },
    {
      "id": "step-2",
      "name": "Step 2",
      "user": "VG Project Controller",
      "script": "./scripts/Zoek traject 3.yml",
      "inject": {
        "Try-out List.Code": "{capture.step-1.try_out_successor_project_no}"
      },
      "depends_on": "step-1"
    }
  ]
}