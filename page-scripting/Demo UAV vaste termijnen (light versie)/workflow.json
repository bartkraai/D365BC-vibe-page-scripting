{
  "$schema": "./workflow.schema.json",
  "name": "Demo UAV vaste termijnen (light versie)",
  "description": "",
  "steps": [
    {
      "id": "step-1",
      "name": "Project registratie",
      "user": "Project Controller",
      "script": "./scripts/Project aanmaken en financieel inrichten 1.yml",
      "capture": {
        "job_card_no": "Job Card - No."
      },
      "company": "TestAT"
    },
    {
      "id": "step-2",
      "name": "Project inrichting",
      "user": "Projectleider",
      "script": "./scripts/Project inrichten en 1e prognose 3.yml",
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-1",
      "company": "TestAT"
    },
    {
      "id": "step-3",
      "name": "Aanmaken inkooporder(s)",
      "user": "Werkvoorbereider",
      "script": "./scripts/Aanmaken inkooporder ter goedkeuring 1.yml",
      "capture": {
        "purchase_order_list_no": "Purchase Order List - No."
      },
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-2",
      "company": "TestAT"
    },
    {
      "id": "step-4",
      "name": "Inkooporder goedkeuren",
      "user": "Projectleider",
      "script": "./scripts/Goedkeuren inkooporder 1.yml",
      "inject": {
        "Approval (Compressed).Document No.": "{capture.step-3.purchase_order_list_no}"
      },
      "depends_on": "step-3",
      "company": "TestAT"
    },
    {
      "id": "step-5",
      "name": "Ontvangst boeken",
      "user": "Uitvoerder GWW 4PS",
      "script": "./scripts/ontvangst boeken inkooporder 1.yml",
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}",
        "Project Purchase Order List.No.": "{capture.step-3.purchase_order_list_no}"
      },
      "depends_on": "step-4",
      "company": "TestAT"
    },
    {
      "id": "step-6",
      "name": "Periodieke administratie",
      "user": "Projectleider",
      "script": "./scripts/Eerste periodieke administratie 1.yml",
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-5",
      "company": "TestAT"
    }
  ]
}