{
  "$schema": "./workflow.schema.json",
  "name": "Termijnschema",
  "description": "",
  "steps": [
    {
      "id": "step-1",
      "name": "Projectregistratie",
      "user": "Project Controller",
      "script": "./scripts/Project aanmaken en financieel inrichten 1 CB.yml",
      "capture": {
        "job_card_no": "Job Card - No."
      },
      "company": "TestAT"
    },
    {
      "id": "step-2",
      "name": "Aanmaken inkooporder",
      "user": "Werkvoorbereider",
      "script": "./scripts/Aanmaken inkooporder 3.yml",
      "capture": {
        "purchase_order_list_no": "Purchase Order List - No."
      },
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-1",
      "company": "TestAT"
    },
    {
      "id": "step-3",
      "name": "Goedkeuren inkooporder",
      "user": "Projectleider",
      "script": "./scripts/Goedkeuring inkooporder 3.yml",
      "inject": {
        "Approval (Compressed).Document No.": "{capture.step-2.purchase_order_list_no}"
      },
      "depends_on": "step-2",
      "company": "TestAT"
    },
    {
      "id": "step-4",
      "name": "Inkooporder ontvangstregistratie",
      "user": "Uitvoerder GWW 4PS",
      "script": "./scripts/Inkooporder ontvangstregistratie 3.yml",
      "inject": {
        "Job List.No.": "{capture.step-1.job_card_no}",
        "Project Purchase Order List.No.": "{capture.step-2.purchase_order_list_no}"
      },
      "depends_on": "step-3",
      "company": "TestAT"
    }
  ]
}