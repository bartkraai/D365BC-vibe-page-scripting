{
  "$schema": "./workflow.schema.json",
  "name": "Test inkoop",
  "description": "",
  "steps": [
    {
      "id": "step-1",
      "name": "Step 1",
      "user": "Projectleider",
      "script": "./scripts/Test aanmaken nieuw project.yml",
      "capture": {
        "job_card_no": "Job Card - No."
      }
    },
    {
      "id": "step-2",
      "name": "Step 2",
      "user": "Werkvoorbereider",
      "script": "./scripts/test Inkooporder aanmaken ter goedkeuring.yml",
      "capture": {
        "null_inkooporder_io230598_is_aangemaakt": "null - Inkooporder IO230598 is aangemaakt."
      },
      "inject": {
        "Projects by Responsible Person.No.": "{capture.step-1.job_card_no}",
        "param_2": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-1"
    },
    {
      "id": "step-3",
      "name": "Step 3",
      "user": "Projectleider",
      "script": "./scripts/Test goedkeuren inkooporder.yml",
      "inject": {
        "Approval (Compressed).Document No.": "{capture.step-1.job_card_no}"
      },
      "depends_on": "step-2"
    }
  ]
}